# Deployment environment: "development" (default) or "production".
# In production the app refuses to start with a weak/default JWT_SECRET or
# wide-open CORS — see internal/config/env.go: Validate().
APP_ENV=development

# HTTP
HTTP_ADDR=:8080
OPENAPIYAML_LOCATION=../openapi.yaml

# CORS: comma-separated allow-list of browser origins ("*" = any, dev only).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SQLite database file location (point at a mounted volume in containers).
DB_PATH=dashboard.db

# JWT
# Generate a strong value with `make gen-secret`. Must be >= 32 bytes in prod.
JWT_SECRET=your-very-secret
JWT_EXPIRED=24h
